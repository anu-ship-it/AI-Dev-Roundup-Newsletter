{
  "Comment": "FILE: infra/state-machine.json. Weekly pipeline: scrape -> pipeline -> email. One image, three stages; each stage is idempotent so retry is safe.",
  "StartAt": "RunScraper",
  "States": {
    "RunScraper": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 900,
      "Parameters": {
        "Cluster": "arn:aws:ecs:ap-south-1:126458880561:cluster/ai-dev-roundup",
        "TaskDefinition": "ai-dev-roundup-scheduler",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["subnet-054c6bea795de3bc4"],
            "SecurityGroups": ["sg-0e23a83da9819795f"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            { "Name": "scheduler", "Command": ["node", "src/index.js", "scrape"] }
          ]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 120, "MaxAttempts": 1, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PipelineFailed" }],
      "Next": "RunPipeline"
    },
    "RunPipeline": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 2400,
      "Parameters": {
        "Cluster": "arn:aws:ecs:ap-south-1:126458880561:cluster/ai-dev-roundup",
        "TaskDefinition": "ai-dev-roundup-scheduler",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["subnet-054c6bea795de3bc4"],
            "SecurityGroups": ["sg-0e23a83da9819795f"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            { "Name": "scheduler", "Command": ["node", "src/index.js", "pipeline"] }
          ]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 120, "MaxAttempts": 1, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PipelineFailed" }],
      "Next": "RunEmail"
    },
    "RunEmail": {
      "Type": "Task",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "TimeoutSeconds": 900,
      "Parameters": {
        "Cluster": "arn:aws:ecs:ap-south-1:126458880561:cluster/ai-dev-roundup",
        "TaskDefinition": "ai-dev-roundup-scheduler",
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["subnet-054c6bea795de3bc4"],
            "SecurityGroups": ["sg-0e23a83da9819795f"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            { "Name": "scheduler", "Command": ["node", "src/index.js", "email"] }
          ]
        }
      },
      "Retry": [{ "ErrorEquals": ["States.TaskFailed"], "IntervalSeconds": 120, "MaxAttempts": 1, "BackoffRate": 2 }],
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "PipelineFailed" }],
      "Next": "PipelineSucceeded"
    },
    "PipelineSucceeded": { "Type": "Succeed" },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineError",
      "Cause": "A pipeline stage failed after retry. See the /ecs/ai-dev-roundup log group."
    }
  }
}
