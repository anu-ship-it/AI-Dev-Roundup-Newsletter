{
  "family": "ai-dev-roundup-ai-pipeline",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::126458880561:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "ai-pipeline",
      "image": "126458880561.dkr.ecr.ap-south-1.amazonaws.com/ai-dev-roundup/ai-pipeline:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ai-dev-roundup",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ai-pipeline"
        }
      },
      "secrets": [
        {
          "name": "MONGODB_URI",
          "valueFrom": "arn:aws:ssm:ap-south-1:126458880561:parameter/ai-dev-roundup/MONGODB_URI"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:ssm:ap-south-1:126458880561:parameter/ai-dev-roundup/DB_NAME"
        },
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:ssm:ap-south-1:126458880561:parameter/ai-dev-roundup/GROQ_API_KEY"
        },
        {
          "name": "MIN_RELEVANCE_SCORE",
          "valueFrom": "arn:aws:ssm:ap-south-1:126458880561:parameter/ai-dev-roundup/MIN_RELEVANCE_SCORE"
        }
      ]
    }
  ]
}